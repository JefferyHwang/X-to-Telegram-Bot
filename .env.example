HOST=0.0.0.0
PORT=3000
DB_PATH=./data/x-to-telegram.sqlite

# Create a bot with @BotFather and add it to the destination chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X API v2 bearer token from the X Developer Portal.
X_BEARER_TOKEN=
X_MONITOR_USERNAMES=

# The first poll only records the latest post by default.
X_PUSH_EXISTING_ON_START=false
X_INCLUDE_REPLIES=false
X_INCLUDE_REPOSTS=false
X_POLL_INTERVAL_SECONDS=300
X_REQUEST_TIMEOUT_MS=15000

# link sends only the X link; link_and_text also includes the post text.
X_FORWARD_MODE=link

# Optional. Protects POST /sync. If empty, POST /sync is disabled.
SYNC_ADMIN_TOKEN=
